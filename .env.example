LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=700
LLM_PLANNER_ENABLED=true
LLM_PLANNER_MAX_TOKENS=160
LLM_PLANNER_TIMEOUT_SECONDS=4
AGENT_REACT_MAX_STEPS=3
AGENT_JUDGE_ENABLED=true
AGENT_JUDGE_ON_SUCCESS_GENERAL=true
AGENT_JUDGE_MAX_TOKENS=160
AGENT_JUDGE_TIMEOUT_SECONDS=4
QUERY_REWRITE_MAX_TOKENS=180
QUERY_REWRITE_TIMEOUT_SECONDS=4
REGULATION_PREFER_DATABASE=true
REGULATION_VECTOR_RETRIEVAL_ENABLED=false
REGULATION_RERANK_ENABLED=true
REGULATION_RERANK_MODEL=BAAI/bge-reranker-v2-m3
REGULATION_RERANK_MAX_CANDIDATES=15
REGULATION_EMBEDDING_QUERY_INSTRUCTION=

RACE_REQUEST_TIMEOUT_SECONDS=3
RACE_CACHE_TTL_SECONDS=300
UPSTREAM_GET_MAX_RETRIES=2
UPSTREAM_GET_BACKOFF_SECONDS=0.2

FORMULA1_FEED_URL=https://www.formula1.com/en/latest/all.xml
MOTORSPORT_FEED_URL=https://www.motorsport.com/rss/f1/news/
NEWS_INGEST_ON_STARTUP=true
NEWS_INGEST_STARTUP_LIMIT=15
NEWS_REQUEST_TIMEOUT_SECONDS=10

SESSION_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=604800
SESSION_HISTORY_MAX_TURNS=20
MEMORY_RECENT_TURNS=4
MEMORY_CONTEXT_TOKEN_BUDGET=1200
MEMORY_SUMMARY_TOKEN_BUDGET=260
MEMORY_COMPACTION_TOKEN_THRESHOLD=1600
MEMORY_LONG_TERM_ENABLED=true
MEMORY_LONG_TERM_BACKEND=memory
MEMORY_LONG_TERM_TTL_SECONDS=2592000
MEMORY_LONG_TERM_TOP_K=3
MEMORY_VECTOR_RETRIEVAL_ENABLED=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pitwall
POSTGRES_USER=pitwall
POSTGRES_PASSWORD=pitwall
