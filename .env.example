APP_NAME=PitWall Agent
APP_LOG_LEVEL=INFO
# CORS 允许来源，逗号分隔；生产环境请勿使用 *
CORS_ALLOW_ORIGINS=*
# 可选 API 访问令牌（Bearer）。为空时所有端点匿名可访问（便于本地开发）；
# 生产环境建议设置，配置后除健康检查/指标外全部请求需携带 Authorization: Bearer <token>
API_ACCESS_TOKEN=

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=700
# LLM 熔断：连续失败达到阈值后进入冷却期，期间 LLM 调用快速失败走降级（0=关闭）
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
LLM_PLANNER_ENABLED=true
LLM_PLANNER_MAX_TOKENS=160
# 多步任务分解（2-4 步依赖链）时 planner 的最大输出 token
LLM_PLANNER_MULTI_MAX_TOKENS=320
LLM_PLANNER_TIMEOUT_SECONDS=4
# ReAct 修复循环最大轮次；多步计划同样受此上限约束
AGENT_REACT_MAX_STEPS=5
# 单轮最多并行执行的工具调用数（tool_calling 模式截断）
AGENT_MAX_PARALLEL_TOOL_CALLS=5
# Planner mode: tool_calling (native model tools) | structured (deterministic plan)
AGENT_PLANNER_MODE=tool_calling
AGENT_JUDGE_ENABLED=true
AGENT_JUDGE_ON_SUCCESS_GENERAL=true
AGENT_JUDGE_MAX_TOKENS=160
AGENT_JUDGE_TIMEOUT_SECONDS=4
QUERY_REWRITE_MAX_TOKENS=180
QUERY_REWRITE_TIMEOUT_SECONDS=4
REGULATION_PREFER_DATABASE=true
REGULATION_VECTOR_RETRIEVAL_ENABLED=false
REGULATION_RERANK_ENABLED=true
REGULATION_RERANK_MODEL=BAAI/bge-reranker-v2-m3
REGULATION_RERANK_MAX_CANDIDATES=15
REGULATION_EMBEDDING_QUERY_INSTRUCTION=
# 法规问答灌入 LLM 的片段 token 预算（0=不限制）
REGULATION_CONTEXT_TOKEN_BUDGET=1800

# HuggingFace 模型缓存与令牌（BGE-M3 / reranker 本地加载）
HF_TOKEN=
HF_HOME=
HF_HUB_CACHE=
TRANSFORMERS_CACHE=
SENTENCE_TRANSFORMERS_HOME=

RACE_REQUEST_TIMEOUT_SECONDS=3
RACE_CACHE_TTL_SECONDS=300
UPSTREAM_GET_MAX_RETRIES=2
UPSTREAM_GET_BACKOFF_SECONDS=0.2

FORMULA1_FEED_URL=https://www.formula1.com/en/latest/all.xml
MOTORSPORT_FEED_URL=https://www.motorsport.com/rss/f1/news/
NEWS_INGEST_ON_STARTUP=true
NEWS_INGEST_STARTUP_LIMIT=15
NEWS_REQUEST_TIMEOUT_SECONDS=10

SESSION_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
# 或使用分项配置：
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
SESSION_TTL_SECONDS=604800
SESSION_HISTORY_MAX_TURNS=20
MEMORY_RECENT_TURNS=4
MEMORY_CONTEXT_TOKEN_BUDGET=1200
MEMORY_SUMMARY_TOKEN_BUDGET=260
MEMORY_COMPACTION_TOKEN_THRESHOLD=1600
MEMORY_LONG_TERM_ENABLED=true
# 长期记忆后端：postgres（推荐，按 user_id 持久化）| redis | memory
MEMORY_LONG_TERM_BACKEND=postgres
MEMORY_LONG_TERM_TTL_SECONDS=2592000
MEMORY_LONG_TERM_TOP_K=3
MEMORY_VECTOR_RETRIEVAL_ENABLED=true
# 每轮对话后用轻量 LLM 提取用户偏好/约束/事实/历史行为
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_TIMEOUT_SECONDS=3
MEMORY_EXTRACTION_MAX_TOKENS=160

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pitwall
POSTGRES_USER=pitwall
POSTGRES_PASSWORD=pitwall
# 完整数据库连接串（设置后覆盖上方 POSTGRES_* 分项）
# DATABASE_URL=postgresql+psycopg://pitwall:pitwall@localhost:5432/pitwall
